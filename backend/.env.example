ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_assistant

FRONTEND_ORIGIN=http://localhost:5173

# Vector DB (ChromaDB — local persistent store, no separate service needed)
CHROMA_PERSIST_DIR=./chroma_data

# LLM (Ollama — runs as its own container, see docker-compose.yml)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage: "local" (default) or "supabase"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads

# Only needed if STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
